{
  "openapi": "3.0.3",
  "info": {
    "title": "DevWeekends API",
    "version": "1.0.0",
    "description": "REST API built with Express and Mongoose. JWT authentication, plus posts and comments on top of the users collection that backs auth.",
    "contact": { "name": "DevWeekends", "url": "https://github.com/" },
    "license": { "name": "MIT", "url": "https://opensource.org/licenses/MIT" }
  },
  "servers": [
    { "url": "/api", "description": "This server" }
  ],
  "tags": [
    { "name": "Authentication", "description": "Register, log in, and read the current user" },
    { "name": "Posts", "description": "CRUD for posts. Reading is public, writing needs a token, editing needs ownership" },
    { "name": "Comments", "description": "Comments live under a post but are addressable on their own" },
    { "name": "System", "description": "Liveness check" }
  ],
  "paths": {
    "/auth/register": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Create an account",
        "description": "Hashes the password with bcrypt in a pre-save hook and returns a token, so there is no need to log in afterwards.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": { "name": "Alice", "email": "alice@example.com", "password": "secret123" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Account created",
            "content": {
              "application/json": {
                "example": {
                  "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
                  "user": { "_id": "6a8144aac4d691949fc89a50", "name": "Alice", "email": "alice@example.com" }
                }
              }
            }
          },
          "400": { "description": "name, email or password missing, or the email is malformed" },
          "409": { "description": "Email already in use" }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Log in",
        "description": "The password field is select:false on the schema, so it is fetched explicitly here and compared with bcrypt.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": { "email": "alice@example.com", "password": "secret123" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Signed in",
            "content": {
              "application/json": {
                "example": {
                  "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
                  "user": { "_id": "6a8144aac4d691949fc89a50", "name": "Alice", "email": "alice@example.com" }
                }
              }
            }
          },
          "400": { "description": "email or password missing" },
          "401": { "description": "Invalid credentials" }
        }
      }
    },
    "/auth/me": {
      "get": {
        "tags": ["Authentication"],
        "summary": "Current user",
        "description": "The auth middleware verifies the Bearer token and loads the user onto the request.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "The user behind the token",
            "content": {
              "application/json": {
                "example": {
                  "user": { "_id": "6a8144aac4d691949fc89a50", "name": "Alice", "email": "alice@example.com" }
                }
              }
            }
          },
          "401": { "description": "Missing, malformed or expired token" }
        }
      }
    },
    "/posts": {
      "get": {
        "tags": ["Posts"],
        "summary": "List posts",
        "description": "Public. Newest first, wrapped in pagination metadata.",
        "parameters": [
          { "name": "page", "in": "query", "description": "1-based page number", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "description": "Items per page, capped at 100", "schema": { "type": "integer", "default": 10 } },
          { "name": "tag", "in": "query", "description": "Exact tag match, lowercased", "schema": { "type": "string" } },
          { "name": "author", "in": "query", "description": "Author's user id", "schema": { "type": "string" } },
          { "name": "q", "in": "query", "description": "Case-insensitive search on the title", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "A page of posts",
            "content": {
              "application/json": {
                "example": {
                  "page": 1,
                  "limit": 10,
                  "total": 1,
                  "pages": 1,
                  "items": [{
                    "_id": "6a814d083abd2919b20e032d",
                    "title": "Express basics",
                    "content": "Routing and middleware",
                    "tags": ["node"],
                    "published": true,
                    "author": { "_id": "6a8144aac4d691949fc89a50", "name": "Alice", "email": "alice@example.com" },
                    "createdAt": "2026-08-16T05:39:20.281Z"
                  }]
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Posts"],
        "summary": "Create a post",
        "description": "The author is taken from the token, not from the body.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "title": "Express basics",
                "content": "Routing and middleware",
                "tags": ["node", "express"],
                "published": true
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "example": {
                  "_id": "6a814d083abd2919b20e032d",
                  "title": "Express basics",
                  "content": "Routing and middleware",
                  "tags": ["node", "express"],
                  "published": true,
                  "author": "6a8144aac4d691949fc89a50",
                  "createdAt": "2026-08-16T05:39:20.281Z"
                }
              }
            }
          },
          "400": { "description": "title or content missing" },
          "401": { "description": "No token" }
        }
      }
    },
    "/posts/{id}": {
      "get": {
        "tags": ["Posts"],
        "summary": "Get one post",
        "description": "Public. The author is populated with name and email.",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "description": "Post id", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "The post",
            "content": {
              "application/json": {
                "example": {
                  "_id": "6a814d083abd2919b20e032d",
                  "title": "Express basics",
                  "content": "Routing and middleware",
                  "tags": ["node"],
                  "published": true,
                  "author": { "_id": "6a8144aac4d691949fc89a50", "name": "Alice", "email": "alice@example.com" },
                  "createdAt": "2026-08-16T05:39:20.281Z"
                }
              }
            }
          },
          "400": { "description": "Malformed id" },
          "404": { "description": "Post not found" }
        }
      },
      "put": {
        "tags": ["Posts"],
        "summary": "Update a post",
        "description": "Author only. Send just the fields you want changed.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "description": "Post id", "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": { "title": "Express basics (updated)", "tags": ["node", "express"] }
            }
          }
        },
        "responses": {
          "200": { "description": "The updated post" },
          "401": { "description": "No token" },
          "403": { "description": "You can only edit your own posts" },
          "404": { "description": "Post not found" }
        }
      },
      "delete": {
        "tags": ["Posts"],
        "summary": "Delete a post",
        "description": "Author only. The post's comments are deleted with it, so nothing is left orphaned.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "description": "Post id", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Deleted",
            "content": { "application/json": { "example": { "message": "Post deleted" } } }
          },
          "401": { "description": "No token" },
          "403": { "description": "You can only delete your own posts" },
          "404": { "description": "Post not found" }
        }
      }
    },
    "/posts/{postId}/comments": {
      "get": {
        "tags": ["Comments"],
        "summary": "List a post's comments",
        "description": "Public. Same pagination shape as the posts list.",
        "parameters": [
          { "name": "postId", "in": "path", "required": true, "description": "Post id", "schema": { "type": "string" } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "description": "Capped at 100", "schema": { "type": "integer", "default": 20 } }
        ],
        "responses": {
          "200": {
            "description": "A page of comments",
            "content": {
              "application/json": {
                "example": {
                  "page": 1,
                  "limit": 20,
                  "total": 1,
                  "pages": 1,
                  "items": [{
                    "_id": "6a814f0a3abd2919b20e0340",
                    "body": "Great write-up",
                    "post": "6a814d083abd2919b20e032d",
                    "author": { "_id": "6a8144aac4d691949fc89a50", "name": "Alice", "email": "alice@example.com" },
                    "createdAt": "2026-08-16T05:47:54.117Z"
                  }]
                }
              }
            }
          },
          "404": { "description": "Post not found" }
        }
      },
      "post": {
        "tags": ["Comments"],
        "summary": "Comment on a post",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "postId", "in": "path", "required": true, "description": "Post id", "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "example": { "body": "Great write-up" } }
          }
        },
        "responses": {
          "201": { "description": "Created" },
          "400": { "description": "body missing" },
          "401": { "description": "No token" },
          "404": { "description": "Post not found" }
        }
      }
    },
    "/comments/{id}": {
      "get": {
        "tags": ["Comments"],
        "summary": "Get one comment",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "description": "Comment id", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "The comment" },
          "404": { "description": "Comment not found" }
        }
      },
      "put": {
        "tags": ["Comments"],
        "summary": "Edit a comment",
        "description": "Author only.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "description": "Comment id", "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "example": { "body": "Edited comment" } } }
        },
        "responses": {
          "200": { "description": "The updated comment" },
          "401": { "description": "No token" },
          "403": { "description": "You can only edit your own comments" },
          "404": { "description": "Comment not found" }
        }
      },
      "delete": {
        "tags": ["Comments"],
        "summary": "Delete a comment",
        "description": "Author only.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "description": "Comment id", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Deleted",
            "content": { "application/json": { "example": { "message": "Comment deleted" } } }
          },
          "401": { "description": "No token" },
          "403": { "description": "You can only delete your own comments" },
          "404": { "description": "Comment not found" }
        }
      }
    },
    "/health": {
      "get": {
        "tags": ["System"],
        "summary": "Health check",
        "description": "Answers without touching the database.",
        "responses": {
          "200": {
            "description": "The server is up",
            "content": { "application/json": { "example": { "status": "ok", "uptime": 148.59 } } }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Send the token from register or login as: Authorization: Bearer <token>"
      }
    }
  }
}
