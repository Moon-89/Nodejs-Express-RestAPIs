PORT=5000

# MongoDB Atlas (Connect -> Drivers -> Node.js). Replace <user>, <password> and the
# cluster host, and put the database name before the "?": .../devweekends?retryWrites...
# A password with special characters must be URL-encoded (@ -> %40, # -> %23).
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/devweekends?retryWrites=true&w=majority

# Local MongoDB instead of Atlas:
# MONGO_URI=mongodb://127.0.0.1:27017/devweekends

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
